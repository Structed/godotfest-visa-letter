@page "/sign"
@using GodotFest.VisaLetter.Letters
@using GodotFest.VisaLetter.Models
@using GodotFest.VisaLetter.Services
@inject BrowserFiles Files
@inject LetterOutput Output

<PageTitle>GodotFest — Issue and sign a visa letter</PageTitle>

<header class="masthead">
    <div>
        <h1>Issue and sign</h1>
        <p class="lede">
            For the office. Open the request file an attendee emailed in, check the details,
            and issue the signed letter. <a href="">Back to the attendee form</a>.
        </p>
    </div>
    <div class="privacy" role="note">
        <strong>The letter is composed here, not received.</strong>
        Only the attendee's data comes in — the wording, the cost clause and the
        §§ 66–68 AufenthG statement are always generated by this tool.
    </div>
</header>

<div class="workspace">
    <section class="form-pane">

        <fieldset>
            <legend>1 · Request file</legend>

            <div class="field">
                <label for="requestFile">Choose the <code>.json</code> attachment</label>
                <InputFile id="requestFile" class="form-control" accept=".json,application/json"
                           OnChange="LoadRequestFileAsync" />
                <span class="hint">Nothing is uploaded — the file is read in this browser.</span>
            </div>

            <div class="field">
                <label for="requestPaste">…or paste its contents</label>
                <textarea id="requestPaste" class="form-control" rows="4" @bind="pasted"
                          placeholder="{ &quot;kind&quot;: &quot;godotfest.visa-letter-request&quot;, … }"></textarea>
                <button type="button" class="btn outline" @onclick="LoadPastedRequest">Read pasted request</button>
            </div>

            @if (problems.Count > 0)
            {
                <ul class="warn">
                    @foreach (var problem in problems)
                    {
                        <li>@problem</li>
                    }
                </ul>
            }
        </fieldset>

        @if (letter is not null)
        {
            <fieldset>
                <legend>2 · Check before signing</legend>

                @if (letter.PassportExpiresTooSoon)
                {
                    <p class="warn">
                        The passport expires before @EventFacts.PassportValidUntilAtLeast.ToString("yyyy-MM-dd"),
                        which is less than three months after departure. Schengen rules require that margin.
                    </p>
                }

                <dl class="review">
                    @foreach (var (label, value) in Review(letter))
                    {
                        <dt>@label</dt>
                        <dd>@value</dd>
                    }
                </dl>

                <p class="footnote">
                    Confirm the ticket exists in Pretix and that the passport details match the copy of
                    the data page before issuing anything.
                </p>

                <div class="field">
                    <label for="signLanguage">Language</label>
                    <select id="signLanguage" class="form-select" @bind="letter.Output">
                        <option value="@LetterOutputLanguage.English">English</option>
                        <option value="@LetterOutputLanguage.German">German</option>
                        <option value="@LetterOutputLanguage.Both">Both (as a zip)</option>
                    </select>
                </div>
            </fieldset>

            <fieldset>
                <legend>3 · Signature</legend>

                <div class="field">
                    <label for="signatureFile">Signature image <span class="hint">PNG with a transparent background, or JPEG</span></label>
                    <InputFile id="signatureFile" class="form-control" accept="image/png,image/jpeg"
                               OnChange="LoadSignatureAsync" />
                </div>

                @if (signature is not null)
                {
                    <div class="sig-preview">
                        <img src="@signature" alt="Signature preview" />
                    </div>
                }

                <p class="warn">
                    The image is kept in this browser's local storage so you do not have to pick it every
                    time. Anyone who can use this browser profile can read it back out, so use this only on
                    your own machine and forget it when you are done. It is never committed to the
                    repository and never uploaded.
                </p>
            </fieldset>

            <div class="actions">
                <button type="button" class="btn primary" disabled="@(signature is null)"
                        @onclick="DownloadSignedAsync">Download signed PDF</button>
                <button type="button" class="btn outline" disabled="@(signature is null)"
                        @onclick="PreviewSignedAsync">Preview signed PDF</button>
                <button type="button" class="btn outline" @onclick="DownloadWetSignatureAsync">
                    Unsigned PDF to print and sign
                </button>
                <button type="button" class="btn ghost" @onclick="DownloadMarkdownAsync">Download Markdown</button>
                <button type="button" class="btn ghost danger" @onclick="ForgetSignatureAsync">Forget signature</button>
                <button type="button" class="btn ghost danger" @onclick="ClearRequest">Clear request</button>
            </div>
        }

        @if (!string.IsNullOrEmpty(status))
        {
            <p class="status @statusKind">@status</p>
        }

        <p class="footnote">
            Send the signed letter with the current Handelsregister extract (issued within six months),
            the ticket confirmation and a copy of the passport data page. Delete the request file and the
            email it arrived in once the letter has gone out.
        </p>
    </section>

    <section class="preview-pane">
        <div class="preview-head">
            <h2>Preview</h2>
        </div>
        <pre class="preview">@PreviewMarkdown</pre>
    </section>
</div>

@code {
    private const long MaxRequestBytes = 256 * 1024;
    private const long MaxSignatureBytes = 4 * 1024 * 1024;

    private LetterData? letter;
    private string? signature;
    private string pasted = string.Empty;
    private string status = string.Empty;
    private string statusKind = "ok";
    private IReadOnlyList<string> problems = [];

    private LetterIssue SignedIssue => LetterIssue.Signed(signature!);

    private LetterLanguage PreviewLanguage =>
        letter is null ? LetterLanguage.English : LetterOutput.Languages(letter.Output)[0];

    private string PreviewMarkdown => letter is null
        ? "Load a request file to see the letter."
        : MarkdownRenderer.Render(LetterComposer.Compose(
            letter,
            PreviewLanguage,
            signature is null ? LetterIssue.WetSignature : SignedIssue));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        signature = await Files.RecallSignatureAsync();
        if (signature is not null)
        {
            Report("Signature restored from this browser.");
            StateHasChanged();
        }
    }

    private void Report(string message, string kind = "ok")
    {
        status = message;
        statusKind = kind;
    }

    /// <summary>
    /// Runs a step that talks to the browser. An exception escaping an event handler tears
    /// the whole Blazor app down until the page is reloaded, taking the loaded request with
    /// it. Failures are reported instead.
    /// </summary>
    private async Task Guard(Func<Task> step)
    {
        try
        {
            await step();
        }
        catch (JSException ex)
        {
            Report($"The browser could not complete that: {ex.Message}", "bad");
        }
    }

    private void Apply(LetterRequestParse parse)
    {
        problems = parse.Problems;
        letter = parse.Ok ? parse.Data : null;
        Report(parse.Message, parse.Ok ? "ok" : "bad");
    }

    private Task LoadRequestFileAsync(InputFileChangeEventArgs e) => Guard(async () =>
    {
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaxRequestBytes));
            Apply(LetterRequestFile.Read(await reader.ReadToEndAsync()));
        }
        catch (IOException)
        {
            Apply(LetterRequestParse.Failed(
                $"That file is larger than {MaxRequestBytes / 1024} KB, so it is not a request file."));
        }
    });

    private void LoadPastedRequest() => Apply(LetterRequestFile.Read(pasted));

    private Task LoadSignatureAsync(InputFileChangeEventArgs e) => Guard(async () =>
    {
        var file = e.File;
        var mime = file.ContentType;

        // pdfmake embeds PNG and JPEG only.
        if (mime is not ("image/png" or "image/jpeg"))
        {
            Report("The signature has to be a PNG or a JPEG.", "bad");
            return;
        }

        try
        {
            using var buffer = new MemoryStream();
            await file.OpenReadStream(MaxSignatureBytes).CopyToAsync(buffer);
            signature = $"data:{mime};base64,{Convert.ToBase64String(buffer.ToArray())}";
        }
        catch (IOException)
        {
            Report($"That image is larger than {MaxSignatureBytes / (1024 * 1024)} MB.", "bad");
            return;
        }

        var remembered = await Files.RememberSignatureAsync(signature);
        Report(remembered
            ? "Signature loaded and remembered in this browser."
            : "Signature loaded. This browser would not store it, so you will need to pick it again next time.");
    });

    private Task ForgetSignatureAsync() => Guard(async () =>
    {
        await Files.ForgetSignatureAsync();
        signature = null;
        Report("Signature forgotten.");
    });

    private void ClearRequest()
    {
        letter = null;
        pasted = string.Empty;
        problems = [];
        Report("Request cleared.");
    }

    private Task DownloadSignedAsync() => Guard(async () =>
    {
        if (letter is null || signature is null)
        {
            return;
        }

        Report("Building the signed PDF…");
        Report(await Output.DownloadPdfAsync(letter, SignedIssue));
    });

    private Task PreviewSignedAsync() => Guard(async () =>
    {
        if (letter is null || signature is null)
        {
            return;
        }

        var opened = await Output.OpenPdfAsync(letter, PreviewLanguage, SignedIssue);
        Report(
            opened
                ? "Signed letter opened in a new tab."
                : "Your browser blocked the preview tab. Allow pop-ups for this site, or download the PDF instead.",
            opened ? "ok" : "bad");
    });

    private Task DownloadWetSignatureAsync() => Guard(async () =>
    {
        if (letter is null)
        {
            return;
        }

        Report(await Output.DownloadPdfAsync(letter, LetterIssue.WetSignature)
            + " Print it, sign and stamp it, then scan at 300 dpi in colour.");
    });

    private Task DownloadMarkdownAsync() => Guard(async () =>
    {
        if (letter is null)
        {
            return;
        }

        Report(await Output.DownloadMarkdownAsync(
            letter, signature is null ? LetterIssue.WetSignature : SignedIssue));
    });

    private static IEnumerable<(string Label, string Value)> Review(LetterData d)
    {
        yield return ("Full name", d.FullName);
        yield return ("Date of birth", Show(d.DateOfBirth));
        yield return ("Place of birth", d.PlaceOfBirth);
        yield return ("Nationality", d.Nationality);
        yield return ("Passport number", d.PassportNumber);
        yield return ("Passport issued", Show(d.PassportIssueDate));
        yield return ("Passport expires", Show(d.PassportExpiryDate));
        yield return ("Residential address", d.HomeAddress);
        yield return ("Employer", d.Employer);
        yield return ("Job title", d.JobTitle);
        yield return ("Role", d.RoleEnglish);
        yield return ("Booking reference", d.TicketOrderId);
        yield return ("Accommodation", d.AccommodationEn);
        yield return ("Mission", d.MissionName);
        yield return ("Mission address", d.MissionAddress);
        yield return ("Letter date", Show(d.LetterDate));
    }

    private static string Show(DateOnly? value) => value?.ToString("yyyy-MM-dd") ?? "—";
}
